{
  "name": "amber-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An amber terminal interface for browser-based LLM sessions.",
  "bin": "dist/src/server.js",
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --watch dist/src/server.js",
    "package": "node scripts/package.mjs",
    "package:linux": "node scripts/package.mjs linux",
    "package:macos": "node scripts/package.mjs macos",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "npm run build && node test/interrupt.e2e.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/shell-quote": "^1.7.5",
    "@yao-pkg/pkg": "6.21.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ignore": "^7.0.6",
    "markdown-it": "^15.0.0",
    "shell-quote": "^1.10.0",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "dist/src/**/*",
      "dist/build-version.txt",
      "node_modules/markdown-it/dist/browser/markdown-it.umd.min.js"
    ]
  }
}
